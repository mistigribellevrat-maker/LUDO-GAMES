# Copier ce fichier en `.env` et renseigner les valeurs reelles.
# `.env` est ignore par git et exclu de manifest.json : il n'est jamais distribue.

# Cle API Google Gemini — https://aistudio.google.com/apikey
GEMINI_API_KEY=

# L'adresse du serveur de scores ne se configure plus ici : voir server_config.json
# (valeur par defaut distribuee avec le jeu) et le champ "Serveur" dans Parametres,
# qui ecrit une valeur propre a ce PC dans server_config.local.json (jamais ecrasee
# par une mise a jour du jeu).
